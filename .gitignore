# IDE
.idea/
*.swp
*~

# Test infrastructure (TIU-S00/S03) — runtime lock + token state, not committed
.alln-test.lock
.alln-test.hmac-key
.alln-test.tokens/

# Workflow local state
.wmd/

# Local scratch (agent review prompts, stderr dumps, one-off notes)
.tmp/

# Cursor (keep hooks.json; ignore local watcher logs)
.wmd/commit-queue-watcher.log
.wmd/commit-queue-watcher.pid

# Design mockups (local reference artifacts)
docs/phases/mockups/

# GUI Visual Proof Gate — transient fixture captures (overwritten each run)
docs/qa/gui/_captures/
docs/qa/ios/_captures/

# Team Lab local experiment records (quota-heavy runs, transcripts, model output)
.lab/

# package-cwd duplicates from `swift run alln dev export-contracts` inside Packages/.
Packages/AllnighterCore/docs/
.aider*
__pycache__/
.allnighter/
