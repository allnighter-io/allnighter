# Allnighter cloud relay — public client config only.
# Never commit .env.
#
# Fast path (Supabase CLI logged in, project already created):
#   scripts/bootstrap_remote_env.sh
#   scripts/serve_remote.sh
#   scripts/ios_live.sh
#
# Project: Allnighter-DB (kfqwpozmntqpxiveafld)
ALLNIGHTER_SUPABASE_URL=https://kfqwpozmntqpxiveafld.supabase.co
ALLNIGHTER_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Mac agent (`alln serve`) and iOS device sessions use Supabase Auth JWTs.
# JWTs expire (~1h). Refresh: scripts/bootstrap_remote_env.sh --refresh
# Mac agent token: same account that registered the mac_agent row.
ALLNIGHTER_SUPABASE_ACCESS_TOKEN=<mac-agent-jwt>
# Device token for the phone; dev bootstrap sets this to the Mac account JWT.
ALLNIGHTER_SUPABASE_DEVICE_ACCESS_TOKEN=<device-jwt>
ALLNIGHTER_REMOTE_ACCOUNT_ID=<supabase-auth-user-uuid>
# Use `local` for email/password dev users; `apple` / `google` in production.
ALLNIGHTER_REMOTE_ACCOUNT_PROVIDER=local
# Must be a UUID — matches public.mac_agents.id (not an arbitrary string slug).
ALLNIGHTER_REMOTE_MAC_AGENT_ID=<stable-uuid>
ALLNIGHTER_REMOTE_MAC_DISPLAY_NAME="Studio Mac"

# Optional live RLS proof fixtures. These are not app runtime config.
# Provide short-lived test JWTs for two distinct Supabase accounts plus an account-A
# Mac/device fixture. The test asserts account A can see its Mac, account B cannot
# see it, and account B cannot write account A's command inbox.
ALLNIGHTER_SUPABASE_RLS_ACCOUNT_A_ID=<uuid>
ALLNIGHTER_SUPABASE_RLS_ACCOUNT_A_JWT=<jwt>
ALLNIGHTER_SUPABASE_RLS_ACCOUNT_B_JWT=<jwt>
ALLNIGHTER_SUPABASE_RLS_MAC_A_ID=<uuid>
ALLNIGHTER_SUPABASE_RLS_DEVICE_A_ID=<device-id>
