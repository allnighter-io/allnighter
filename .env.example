# Allnighter cloud relay — public client config only.
# Copy to .env and fill in values. Never commit .env.
#
# Project: Allnighter-DB (kfqwpozmntqpxiveafld)
ALLNIGHTER_SUPABASE_URL=https://kfqwpozmntqpxiveafld.supabase.co
ALLNIGHTER_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Optional live RLS proof fixtures. These are not app runtime config.
# Provide short-lived test JWTs for two distinct Supabase accounts plus an account-A
# Mac/device fixture. The test asserts account A can see its Mac, account B cannot
# see it, and account B cannot write account A's command inbox.
ALLNIGHTER_SUPABASE_RLS_ACCOUNT_A_ID=<uuid>
ALLNIGHTER_SUPABASE_RLS_ACCOUNT_A_JWT=<jwt>
ALLNIGHTER_SUPABASE_RLS_ACCOUNT_B_JWT=<jwt>
ALLNIGHTER_SUPABASE_RLS_MAC_A_ID=<uuid>
ALLNIGHTER_SUPABASE_RLS_DEVICE_A_ID=<device-id>
