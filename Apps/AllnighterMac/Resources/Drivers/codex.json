{
  "id": "codex",
  "manifestVersion": 1,
  "displayName": "Codex / ChatGPT CLI",
  "kind": "headless_cli",
  "detectCommand": "codex --version",
  "smokeTestCommand": "codex exec \"Reply with the single token ALLNIGHTER_READY\"",
  "smokeTestExpect": "ALLNIGHTER_READY",
  "invoke": {
    "command": "codex",
    "args": ["exec", "{{prompt}}"],
    "promptVia": "arg",
    "env": {},
    "workingDir": null,
    "timeoutSeconds": 300
  },
  "output": {
    "capture": "stdout",
    "stripAnsi": true,
    "doneSignal": "exit_code",
    "sentinel": null
  }
}
