{
  "id": "antigravity",
  "manifestVersion": 1,
  "displayName": "Antigravity",
  "kind": "headless_cli",
  "maxConcurrentSpawns": 1,
  "detectCommand": "agy --version",
  "smokeTestCommand": "agy --print \"Reply with the single token ALLNIGHTER_READY\" --model \"{{model}}\" --dangerously-skip-permissions",
  "smokeTestExpect": "ALLNIGHTER_READY",
  "invoke": {
    "command": "agy",
    "args": [
      "--print",
      "{{prompt}}",
      "--model",
      "{{model}}",
      "--dangerously-skip-permissions"
    ],
    "promptVia": "arg",
    "env": {},
    "workingDir": null,
    "timeoutSeconds": 1800
  },
  "output": {
    "capture": "stdout",
    "stripAnsi": true,
    "doneSignal": "exit_code",
    "sentinel": null
  },
  "imageGen": {
    "args": [
      "--print",
      "{{prompt}}",
      "--model",
      "{{model}}",
      "--dangerously-skip-permissions",
      "--print-timeout",
      "10m"
    ],
    "promptVia": "arg",
    "promptTemplate": "Use your image generation tool to create an actual raster PNG image (not a markdown file, not HTML) of: {{designPrompt}} After generating, reply with ONLY the absolute filesystem path to the saved .png file.",
    "arrival": "stdout_path",
    "stdoutPathRegex": "(/[^\\s)]+\\.png)",
    "sessionIdRegex": "brain/([0-9a-fA-F-]{8,})/",
    "timeoutSeconds": 600
  },
  "setup": {
    "bins": [
      "agy"
    ],
    "knownPaths": [
      "~/.local/bin",
      "~/.antigravity/antigravity/bin",
      "/opt/homebrew/bin"
    ],
    "installHint": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
    "docsURL": "https://antigravity.google/docs/cli-install",
    "loginFlow": {
      "interactiveCommand": "agy",
      "instructions": "Run `agy`. It tries silent auth via the Apple Keychain; if there's no token it opens a browser for Google / Google Cloud sign-in (SSH sessions use a paste-the-code flow). Sign out with `/logout` inside the TUI.",
      "authErrorPatterns": [
        "sign in",
        "log in",
        "login",
        "auth",
        "oauth",
        "not authenticated",
        "authentication",
        "keyring",
        "401"
      ],
      "docsURL": "https://antigravity.google/docs/cli-install"
    }
  },
  "session": {
    "continuity": "vendor_session",
    "acquire": "capture",
    "capture": {
      "from": "session_dir",
      "dir": "~/.gemini/antigravity-cli/brain"
    },
    "resumeArgs": [
      "--print",
      "{{prompt}}",
      "--model",
      "{{model}}",
      "--dangerously-skip-permissions",
      "--conversation",
      "{{sessionId}}"
    ]
  }
}
