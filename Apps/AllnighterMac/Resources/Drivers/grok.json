{
  "id": "grok",
  "manifestVersion": 1,
  "displayName": "Grok Build CLI",
  "kind": "headless_cli",
  "detectCommand": "grok --version",
  "smokeTestCommand": "grok -p \"Reply with the single token ALLNIGHTER_READY\" -m {{model}} --output-format plain",
  "smokeTestExpect": "ALLNIGHTER_READY",
  "invoke": {
    "command": "grok",
    "args": [
      "-p",
      "{{prompt}}",
      "-m",
      "{{model}}",
      "{{effortArgs}}",
      "--output-format",
      "streaming-json",
      "--always-approve",
      "--no-wait-for-background",
      "--no-subagents",
      "--disable-web-search",
      "--cwd",
      "{{workingDir}}"
    ],
    "promptVia": "arg",
    "env": {},
    "workingDir": null,
    "timeoutSeconds": 1800,
    "effortFlag": {
      "flag": "--reasoning-effort",
      "levels": {
        "low": "low",
        "med": "medium",
        "high": "high"
      }
    }
  },
  "output": {
    "capture": "stdout",
    "stripAnsi": true,
    "doneSignal": "exit_code",
    "sentinel": null
  },
  "streaming": {
    "supported": true,
    "mode": "jsonl_stdout",
    "args": [],
    "partialOutput": true,
    "answerDeltaPaths": [
      "$.data"
    ],
    "finalAnswerSource": "parser_accumulator",
    "stripAnsi": true,
    "visibleReasoning": false
  },
  "imageGen": {
    "args": [
      "-p",
      "{{prompt}}",
      "--yolo",
      "--output-format",
      "json",
      "--cwd",
      "{{runDir}}"
    ],
    "promptVia": "arg",
    "promptTemplate": "Generate an image: {{designPrompt}}. Save the final image to {{imageOut}} and reply with the absolute path only.",
    "arrival": "prompt_directed",
    "stdoutPathRegex": "\"path\"\\s*:\\s*\"([^\"]+)\"",
    "sessionIdRegex": "\"sessionId\"\\s*:\\s*\"([^\"]+)\"",
    "timeoutSeconds": 600
  },
  "setup": {
    "bins": [
      "grok"
    ],
    "knownPaths": [
      "~/.local/bin",
      "~/.grok/bin",
      "/opt/homebrew/bin"
    ],
    "installHint": "curl -fsSL https://x.ai/cli/install.sh | bash",
    "docsURL": "https://x.ai/cli",
    "loginFlow": {
      "interactiveCommand": "grok login",
      "instructions": "Run `grok login` (or just `grok`) once to sign in via browser with your SuperGrok or X Premium+ account. That caches a session token under ~/.grok/ that `grok -p` reuses \u2014 no API key needed.",
      "authErrorPatterns": [
        "not authenticated",
        "authentication required",
        "unauthorized",
        "sign in",
        "log in",
        "login",
        "auth",
        "401"
      ],
      "docsURL": "https://docs.x.ai/build/overview"
    }
  },
  "session": {
    "continuity": "vendor_session",
    "acquire": "capture",
    "resumeArgs": [
      "-p",
      "{{prompt}}",
      "-m",
      "{{model}}",
      "{{effortArgs}}",
      "--output-format",
      "streaming-json",
      "--always-approve",
      "--no-wait-for-background",
      "--no-subagents",
      "--disable-web-search",
      "--cwd",
      "{{workingDir}}",
      "--resume",
      "{{sessionId}}"
    ],
    "capture": {
      "from": "stream_json",
      "field": "sessionId"
    }
  }
}
