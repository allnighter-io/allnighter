{
  "id": "kimi",
  "manifestVersion": 1,
  "displayName": "Kimi Code CLI",
  "kind": "headless_cli",
  "detectCommand": "kimi --version",
  "smokeTestCommand": "kimi -p \"Reply with the single token ALLNIGHTER_READY\" -m {{model}} --output-format text",
  "smokeTestExpect": "ALLNIGHTER_READY",
  "invoke": {
    "command": "kimi",
    "args": [
      "-p",
      "{{prompt}}",
      "-m",
      "{{model}}",
      "--output-format",
      "stream-json"
    ],
    "promptVia": "arg",
    "env": {},
    "workingDir": null,
    "timeoutSeconds": 1800
  },
  "output": {
    "capture": "stdout",
    "stripAnsi": true,
    "doneSignal": "exit_code",
    "sentinel": null
  },
  "streaming": {
    "supported": true,
    "mode": "jsonl_stdout",
    "args": [],
    "partialOutput": true,
    "answerDeltaPaths": [
      "$.content"
    ],
    "finalAnswerSource": "parser_accumulator",
    "stripAnsi": true,
    "visibleReasoning": false
  },
  "session": {
    "continuity": "vendor_session",
    "acquire": "capture",
    "resumeArgs": [
      "-p",
      "{{prompt}}",
      "-m",
      "{{model}}",
      "--output-format",
      "stream-json",
      "--session",
      "{{sessionId}}"
    ],
    "capture": {
      "from": "stream_json",
      "field": "session_id"
    }
  },
  "setup": {
    "bins": [
      "kimi"
    ],
    "knownPaths": [
      "~/.kimi-code/bin",
      "/opt/homebrew/bin",
      "/usr/local/bin",
      "~/.local/bin"
    ],
    "installHint": "Install with: curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash (or brew install kimi-code)",
    "docsURL": "https://www.kimi.com/code/docs/en/kimi-code-cli/guides/getting-started.html",
    "loginFlow": {
      "interactiveCommand": "kimi login",
      "instructions": "Run `kimi login` and complete the device-code flow in the browser. If models are missing after login, run `kimi login` again.",
      "authErrorPatterns": [
        "no model configured",
        "not configured in config.toml",
        "/login",
        "unauthorized",
        "401"
      ],
      "docsURL": "https://www.kimi.com/code/docs/en/kimi-code-cli/configuration/providers.html"
    }
  }
}
