{
  "id": "claude_code",
  "manifestVersion": 1,
  "displayName": "Claude Code",
  "kind": "headless_cli",
  "detectCommand": "claude --version",
  "smokeTestCommand": "claude -p \"Reply with the single token ALLNIGHTER_READY\" --model {{model}}",
  "smokeTestExpect": "ALLNIGHTER_READY",
  "invoke": {
    "command": "claude",
    "args": ["-p", "{{prompt}}", "--model", "{{model}}"],
    "promptVia": "arg",
    "env": {},
    "workingDir": null,
    "timeoutSeconds": 300
  },
  "output": {
    "capture": "stdout",
    "stripAnsi": true,
    "doneSignal": "exit_code",
    "sentinel": null
  },
  "readsImages": true,
  "setup": {
    "bins": ["claude"],
    "knownPaths": ["~/.local/bin", "/opt/homebrew/bin", "~/.npm-global/bin", "/usr/local/bin"],
    "installHint": "Install Claude Code: curl -fsSL https://claude.ai/install.sh | bash  (or npm i -g @anthropic-ai/claude-code)",
    "docsURL": "https://code.claude.com/docs/en/quickstart",
    "loginFlow": {
      "interactiveCommand": "claude",
      "instructions": "Run `claude`, then type `/login` and finish sign-in in the browser.",
      "authErrorPatterns": ["invalid api key", "not logged in", "unauthorized", "/login", "authentication", "401"],
      "docsURL": "https://code.claude.com/docs/en/quickstart"
    }
  }
}
