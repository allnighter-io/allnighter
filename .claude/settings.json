{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Bash(bash *)",
      "Bash(swift *)",
      "Bash(xcodebuild *)",
      "Bash(python3 *)",
      "Bash(gh *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git rebase *)",
      "Bash(git check-ignore *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(perl *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "WebSearch",
      "WebFetch(domain:localhost)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf /*)"
    ]
  }
}
